[
  { "text": "读书破万卷，下笔如有神。", "from": "杜甫" },
  { "text": "欲穷千里目，更上一层楼。", "from": "王之涣《登鹳雀楼》" },
  { "text": "少壮不努力，老大徒伤悲。", "from": "《长歌行》" },
  { "text": "谁知盘中餐，粒粒皆辛苦。", "from": "李绅《悯农》" },
  { "text": "春眠不觉晓，处处闻啼鸟。", "from": "孟浩然《春晓》" },
  { "text": "海内存知己，天涯若比邻。", "from": "王勃" },
  { "text": "千里之行，始于足下。", "from": "老子" },
  { "text": "失败是成功之母。", "from": "谚语" },
  { "text": "一寸光阴一寸金，寸金难买寸光阴。", "from": "谚语" },
  { "text": "团结就是力量。", "from": "谚语" },
  { "text": "今日事，今日毕。", "from": "谚语" },
  { "text": "好习惯，一辈子。", "from": "谚语" }
]
